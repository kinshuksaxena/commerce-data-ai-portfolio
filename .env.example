# =========================================================================
# Unified Commerce Platform Environment Configuration Template
# Copy this file to .env and fill in your values
# =========================================================================

# Database Connection URL (PostgreSQL / Neon Serverless Pooled)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# Individual PostgreSQL Connection Parameters
POSTGRES_HOST=<your-postgres-host>
POSTGRES_PORT=5432
POSTGRES_USER=<your-postgres-user>
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_DB=neondb
POSTGRES_SSLMODE=require

# Airflow Metadata DB Connection (Dedicated 'airflow' schema recommended)
AIRFLOW_DATABASE_SQL_ALCHEMY_CONN=postgresql+psycopg2://<airflow-user>:<password>@<host>:5432/<database>?sslmode=require

# Google Cloud Platform, BigQuery & Cloud Storage Configurations
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=commerce_analytics
BRONZE_BUCKET=commerce-lakehouse-bronze
